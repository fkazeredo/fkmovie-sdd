# fkmovies environment variables — copy to .env.local and fill in real values.
# .env.local is git-ignored; never commit secrets (spec 0000 / spec 0001).

# --- Database (spec 0001; values match compose.yaml local dev service) ---
DB_URL=jdbc:postgresql://localhost:5432/fkmovies
DB_USER=fkmovies
DB_PASSWORD=fkmovies

# --- JWT (consumed from spec 0003; TTLs per ADR 0005, Spring Duration syntax) ---
# Minimum 32 characters; generate a random value per environment.
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# --- Mail (consumed from spec 0006; local dev assumes a Mailpit/MailHog on 1025) ---
MAIL_HOST=localhost
MAIL_PORT=1025
# Optional: leave empty for unauthenticated local SMTP.
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@fkmovies.local
# Optional: when set, every outgoing email is redirected to this address (non-prod safety).
MAIL_TO_OVERRIDE=

# --- Payment webhook (consumed from spec 0015; HMAC-SHA256 secret per ADR 0006) ---
PAYMENT_WEBHOOK_SECRET=change-me-payment-webhook-secret

# --- Runtime ---
APP_TIMEZONE=UTC
