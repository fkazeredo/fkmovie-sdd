{
  "uid": "fkmovies-logs",
  "title": "fkmovies — Logs",
  "tags": ["fkmovies", "logs"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "annotations": { "list": [] },
  "templating": {
    "list": [
      {
        "name": "level",
        "label": "Level",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values(level)",
        "definition": "label_values(level)",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": false,
        "allValue": ".+",
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "logger",
        "label": "Logger",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values(logger)",
        "definition": "label_values(logger)",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": false,
        "allValue": ".+",
        "current": { "text": "All", "value": "$__all" }
      },
      {
        "name": "search",
        "label": "Search text",
        "type": "textbox",
        "query": "",
        "current": { "text": "", "value": "" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Errors (selected range)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "color": { "mode": "fixed", "fixedColor": "red" }, "unit": "short" },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service=\"fkmovies-backend\"} | level=\"ERROR\" [$__range]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Warnings (selected range)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": { "color": { "mode": "fixed", "fixedColor": "orange" }, "unit": "short" },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(count_over_time({service=\"fkmovies-backend\"} | level=\"WARN\" [$__range]))"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Log volume by level (/1m)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 5, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (level) (count_over_time({service=\"fkmovies-backend\"} | logger=~\"$logger\" [1m]))",
          "legendFormat": "{{level}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "logs",
      "title": "Backend logs — level=$level, logger=$logger",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 22, "w": 24, "x": 0, "y": 5 },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=\"fkmovies-backend\"} | level=~\"$level\" | logger=~\"$logger\" |~ \"$search\""
        }
      ]
    }
  ]
}
