{
  "uid": "fkmovies-overview",
  "title": "fkmovies — Overview",
  "tags": ["fkmovies"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Reservations confirmed (total)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "refId": "A", "expr": "sum(reservations_confirmed_total)" }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Reservations created (total)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "refId": "A", "expr": "sum(reservations_created_total)" }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "WebSocket connections (active)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "targets": [{ "refId": "A", "expr": "sum(ws_connections_active)" }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Payments (total by status)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "targets": [{ "refId": "A", "expr": "sum by (status) (payments_total)", "legendFormat": "{{status}}" }]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "HTTP request rate (req/s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [{ "refId": "A", "expr": "sum by (uri) (rate(http_server_requests_seconds_count[1m]))", "legendFormat": "{{uri}}" }]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "JVM heap used (bytes)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [{ "refId": "A", "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})", "legendFormat": "heap used" }]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Reservation lifecycle (rate /5m)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "targets": [
        { "refId": "A", "expr": "sum(rate(reservations_created_total[5m]))", "legendFormat": "created" },
        { "refId": "B", "expr": "sum(rate(reservations_confirmed_total[5m]))", "legendFormat": "confirmed" },
        { "refId": "C", "expr": "sum(rate(reservations_expired_total[5m]))", "legendFormat": "expired" },
        { "refId": "D", "expr": "sum(rate(reservations_cancelled_total[5m]))", "legendFormat": "cancelled" }
      ]
    },
    {
      "id": 8,
      "type": "logs",
      "title": "Backend logs (Loki)",
      "datasource": { "type": "loki", "uid": "loki" },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 20 },
      "options": { "showTime": true, "wrapLogMessage": true, "sortOrder": "Descending", "enableLogDetails": true },
      "targets": [{ "refId": "A", "expr": "{service=\"fkmovies-backend\"}" }]
    }
  ]
}
