<?xml version="1.0" encoding="UTF-8"?>
<!-- Structured JSON logs to stdout (SPEC-0001, architecture/observability.md).
     Field names follow the spec: timestamp, level, logger, message; MDC entries
     (correlationId, later userId/tenantId) are included automatically. -->
<configuration>
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder class="net.logstash.logback.encoder.LogstashEncoder">
      <fieldNames>
        <timestamp>timestamp</timestamp>
        <logger>logger</logger>
        <thread>[ignore]</thread>
        <version>[ignore]</version>
        <levelValue>[ignore]</levelValue>
      </fieldNames>
    </encoder>
  </appender>

  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
  </root>
</configuration>
