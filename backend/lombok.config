# Lombok configuration (project root for the backend module).
config.stopBubbling = true

# Keep generated code out of coverage/static-analysis reach.
lombok.addLombokGeneratedAnnotation = true

# Fluent accessors: @Getter generates `title()`, not `getTitle()` — matches the codebase's
# record-style accessor convention so call sites stay unchanged.
lombok.accessors.fluent = true

# Let @RequiredArgsConstructor copy Spring's @Value onto the generated constructor params,
# so @Value-annotated final fields still bind.
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Value
