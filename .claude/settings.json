{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)",
      "Bash(rm -rf *)",
      "Bash(docker volume rm*)",
      "Bash(docker system prune*)",
      "Bash(docker compose down -v*)",
      "Bash(mvn flyway:clean*)",
      "Bash(./mvnw flyway:clean*)",
      "Bash(.\\mvnw.cmd flyway:clean*)",
      "Bash(dropdb*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(git rebase*)",
      "Bash(docker compose down*)",
      "Bash(rm -r *)",
      "Bash(mvn flyway:*)",
      "Bash(psql*)"
    ],
    "allow": [
      "Bash(mvn -q*)",
      "Bash(mvn test*)",
      "Bash(mvn verify*)",
      "Bash(mvn compile*)",
      "Bash(mvn spotless:apply*)",
      "Bash(mvn spotless:check*)",
      "Bash(mvn checkstyle:check*)",
      "Bash(./mvnw -q*)",
      "Bash(./mvnw -v*)",
      "Bash(./mvnw test*)",
      "Bash(./mvnw verify*)",
      "Bash(./mvnw compile*)",
      "Bash(./mvnw spotless:apply*)",
      "Bash(./mvnw spotless:check*)",
      "Bash(./mvnw checkstyle:check*)",
      "Bash(.\\mvnw.cmd -q*)",
      "Bash(.\\mvnw.cmd -v*)",
      "Bash(.\\mvnw.cmd test*)",
      "Bash(.\\mvnw.cmd verify*)",
      "Bash(.\\mvnw.cmd compile*)",
      "Bash(.\\mvnw.cmd spotless:apply*)",
      "Bash(.\\mvnw.cmd spotless:check*)",
      "Bash(.\\mvnw.cmd checkstyle:check*)",
      "Bash(npm run lint*)",
      "Bash(npm test*)",
      "Bash(npm run build*)",
      "Bash(ng test*)",
      "Bash(ng lint*)",
      "Bash(ng build*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/protect-generated.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/format-java.sh"
          }
        ]
      }
    ]
  }
}
